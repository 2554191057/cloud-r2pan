{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-r2pan",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // ═══════════════ D1 数据库绑定 ═══════════════
  // 本地开发时 wrangler 会自动创建 .wrangler/state/v3/d1/cloud-r2pan/data.sqlite
  // 生产部署时，如果 Cloudflare 控制台已配置同名绑定会自动覆盖；如果未配置 database_id
  // 部署时会从 Cloudflare API 查找名为 cloud-r2pan 的 D1 数据库并绑定。
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "cloud-r2pan",
      "database_id": ""
    }
  ],

  // ═══════════════ 环境变量（本地开发用，生产由 Cloudflare 控制台覆盖） ═══════════════
  "vars": {
    "admin": "local-dev-secret-change-me"
  },

  // 将 public/*.html 作为文本模块导入
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],

  "observability": { "enabled": true }
}